  "userName": "testclient",
  "firstName": "Test",
  "middleName": "Client",
  "lastName": "Account",
  "ContactNumber": "+639000000002",
  "birthDate": "2000-01-01T00:00:00Z",
  "userIMG": null,
  "email": "testclient@example.com",
  "password": "TestPassword123!",
  "role": "Client"
}

